{
  "framework": "nextjs",
  "functions": {
    "app/api/news/sweep/route.ts": { "maxDuration": 60 },
    "app/api/news/refresh/route.ts": { "maxDuration": 60 },
    "app/api/cron/news/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/brief",
      "schedule": "0 12,13 * * 1-5"
    },
    {
      "path": "/api/news/sweep",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/news/sweep",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/ceo",
      "schedule": "30 13,14 * * *"
    },
    {
      "path": "/api/cron/snapshot",
      "schedule": "55 6,7 * * *"
    }
  ]
}
